
import os
import re
import subprocess
import threading
import tkinter as tk
from tkinter import ttk, filedialog, messagebox
from tqdm import tqdm

SEVEN_ZIP = r"C:\Program Files\7-Zip\7z.exe"


class Extractor:

    def __init__(self, root):
        self.root = root
        self.root.title("Bulk ZIP & RAR Extractor")
        self.root.geometry("700x510")

        self.folder = tk.StringVar()
        self.delete_original = tk.BooleanVar(value=True)
        self.stop_flag = False

        tk.Label(
            root,
            text="ZIP / RAR Sequential Extractor",
            font=("Arial", 17, "bold")
        ).pack(pady=15)

        frame = tk.Frame(root)
        frame.pack(fill="x", padx=15)

        tk.Entry(
            frame, textvariable=self.folder, width=65
        ).pack(side="left", padx=5)

        tk.Button(
            frame, text="Browse",
            command=self.browse
        ).pack(side="left")

        tk.Checkbutton(
            root,
            text="Delete archive after successful extraction",
            variable=self.delete_original
        ).pack(pady=8)

        self.status = tk.Label(
            root, text="Ready",
            font=("Arial", 11)
        )
        self.status.pack(pady=5)

        self.progress = ttk.Progressbar(
            root, length=650, mode="determinate"
        )
        self.progress.pack(pady=10)

        self.log = tk.Text(root, height=16, width=82)
        self.log.pack(padx=10, pady=5)

        buttons = tk.Frame(root)
        buttons.pack(pady=10)

        tk.Button(
            buttons,
            text="START",
            bg="green",
            fg="white",
            width=18,
            command=self.start
        ).pack(side="left", padx=10)

        tk.Button(
            buttons,
            text="STOP",
            bg="red",
            fg="white",
            width=18,
            command=self.stop
        ).pack(side="left", padx=10)

    def browse(self):
        folder = filedialog.askdirectory()
        if folder:
            self.folder.set(folder)

    def log_message(self, message):
        self.root.after(
            0, lambda: self._log(message)
        )

    def _log(self, message):
        self.log.insert(tk.END, message + "\n")
        self.log.see(tk.END)

    def set_status(self, message):
        self.root.after(
            0, lambda: self.status.config(text=message)
        )

    def set_progress(self, value, maximum):
        def update():
            self.progress["maximum"] = max(maximum, 1)
            self.progress["value"] = value

        self.root.after(0, update)

    def start(self):
        if not os.path.isfile(SEVEN_ZIP):
            messagebox.showerror(
                "7-Zip Missing",
                "7z.exe not found.\n"
                "Install 7-Zip or update SEVEN_ZIP path."
            )
            return

        if not os.path.isdir(self.folder.get()):
            messagebox.showerror(
                "Error", "Select a valid folder"
            )
            return

        self.stop_flag = False
        self.log.delete("1.0", tk.END)

        threading.Thread(
            target=self.process,
            daemon=True
        ).start()

    def stop(self):
        self.stop_flag = True
        self.set_status(
            "Stopping after current archive..."
        )

    def extract(self, archive, destination):

        command = [
            SEVEN_ZIP,
            "x",
            "-y",
            "-bsp1",
            "-bso1",
            "-bse1",
            f"-o{destination}",
            archive
        ]

        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            encoding="utf-8",
            errors="replace",
            bufsize=1
        )

        for line in process.stdout:
            match = re.search(r"(\d{1,3})%", line)

            if match:
                percent = min(int(match.group(1)), 100)
                self.set_status(
                    f"Extracting: {os.path.basename(archive)} "
                    f"({percent}%)"
                )

        return_code = process.wait()
        return return_code == 0, return_code

    def process(self):

        folder = self.folder.get()

        archives = sorted([
            os.path.join(folder, f)
            for f in os.listdir(folder)
            if f.lower().endswith((".zip", ".rar"))
            and not re.search(
                r"\.part\d+\.rar$", f, re.IGNORECASE
            )
        ])

        total = len(archives)

        if not total:
            self.set_status("No ZIP/RAR archives found")
            return

        self.log_message(f"Found {total} archives")

        success = 0
        failed = 0
        deleted = 0

        with tqdm(
            total=total,
            desc="Archives",
            unit="archive"
        ) as bar:

            for index, archive in enumerate(archives, 1):

                if self.stop_flag:
                    break

                filename = os.path.basename(archive)

                destination = os.path.join(
                    folder,
                    os.path.splitext(filename)[0]
                )

                self.set_status(
                    f"Processing {index}/{total}: {filename}"
                )

                self.log_message(
                    f"\n[{index}/{total}] {filename}"
                )

                try:
                    os.makedirs(destination, exist_ok=True)

                    ok, code = self.extract(
                        archive, destination
                    )

                    if ok:
                        success += 1
                        self.log_message("EXTRACTION SUCCESS")

                        if self.delete_original.get():
                            os.remove(archive)
                            deleted += 1
                            self.log_message("Original archive deleted")

                    else:
                        failed += 1
                        self.log_message(
                            f"EXTRACTION FAILED (Exit code: {code})"
                        )
                        self.log_message("Original archive retained")

                except Exception as e:
                    failed += 1
                    self.log_message(f"ERROR: {e}")

                bar.update(1)
                self.set_progress(index, total)

        self.set_status(
            f"Finished | Success: {success} | Failed: {failed}"
        )

        self.log_message("\n========== FINAL REPORT ==========")
        self.log_message(f"Total: {total}")
        self.log_message(f"Successful: {success}")
        self.log_message(f"Failed: {failed}")
        self.log_message(f"Deleted: {deleted}")

        self.root.after(
            0,
            lambda: messagebox.showinfo(
                "Completed",
                f"Successful: {success}\n"
                f"Failed: {failed}\n"
                f"Deleted: {deleted}"
            )
        )


if __name__ == "__main__":
    root = tk.Tk()
    app = Extractor(root)
    root.mainloop()
